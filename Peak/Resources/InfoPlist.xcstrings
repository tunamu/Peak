      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Peak saves your water intake and completed workouts, with the distance of your walks, to Apple Health."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak, içtiğin suyu ve tamamladığın antrenmanları, yürüyüşlerinin mesafesiyle birlikte Sağlık uygulamasına kaydeder."
