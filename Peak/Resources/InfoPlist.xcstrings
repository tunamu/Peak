      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Peak reads steps, sleep, heart rate variability, resting heart rate and water to show your daily progress and Energy Level."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak, günlük ilerlemeni ve Enerji Seviyeni göstermek için adım, uyku, kalp atış hızı değişkenliği, dinlenik nabız ve su verilerini okur."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
