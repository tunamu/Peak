{
  "sourceLanguage" : "en",
  "strings" : {
    "A routine rotates through your workouts. Create a workout first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutin, antrenmanların arasında sırayla döner. Önce bir antrenman oluştur."
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam"
          }
        }
      }
    },
    "Create Routine" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutin Oluştur"
          }
        }
      }
    },
    "Create Workout" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenman Oluştur"
          }
        }
      }
    },
    "Finish" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitir"
          }
        }
      }
    },
    "From a Peak export, an Excel or a CSV file." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Peak dışa aktarımından, Excel ya da CSV dosyasından."
          }
        }
      }
    },
    "How do you want to start?" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasıl başlamak istersin?"
          }
        }
      }
    },
    "Import My Data" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verilerimi İçe Aktar"
          }
        }
      }
    },
    "“%@” is out of range" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” geçerli aralığın dışında"
          }
        }
      }
    },
    "Log your workouts, follow your next targets, and keep an eye on steps, water and energy." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenmanlarını kaydet, sıradaki hedeflerini takip et; adım, su ve enerjine göz kulak ol."
          }
        }
      }
    },
    "No routines yet. A routine plans which workout comes on which day." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz rutin yok. Rutin, hangi gün hangi antrenmanın geleceğini planlar."
          }
        }
      }
    },
    "Nothing to import with these settings. Try another header row or layout above." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayarlarla içe aktarılacak bir şey yok. Yukarıdan başka bir başlık satırı ya da düzen dene."
          }
        }
      }
    },
    "Not Now" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi Değil"
          }
        }
      }
    },
    "No workouts yet. A workout is the movements you do together." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz antrenman yok. Antrenman, birlikte yaptığın hareketlerin listesidir."
          }
        }
      }
    },
    "Off, everything stays on this iPhone. You can change this in Settings." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken her şey bu iPhone'da kalır. Bunu Ayarlar'dan değiştirebilirsin."
          }
        }
      }
    },
    "Reads steps, sleep, heart rate variability, resting heart rate and water for your Energy Level." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji Seviyen için adım, uyku, kalp atış hızı değişkenliği, dinlenme nabzı ve su verilerini okur."
          }
        }
      }
    },
    "Saves your water and finished workouts." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suyunu ve biten antrenmanlarını kaydeder."
          }
        }
      }
    },
    "Set up your own workouts in Settings." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi antrenmanlarını Ayarlar'dan kur."
          }
        }
      }
    },
    "Six workouts and a Monday, Wednesday, Friday routine. Change anything later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altı antrenman ve Pazartesi, Çarşamba, Cuma rutini. Sonra istediğini değiştir."
          }
        }
      }
    },
    "Start Empty" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş Başla"
          }
        }
      }
    },
    "Start with a Sample Program" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örnek Programla Başla"
          }
        }
      }
    },
    "Sync your workouts between your devices through your own iCloud account." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenmanlarını kendi iCloud hesabın üzerinden cihazların arasında eşzamanla."
          }
        }
      }
    },
    "Turn On" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aç"
          }
        }
      }
    },
    "Used Peak on another device? Its data arrives on its own, so start empty." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak'i başka bir cihazda kullandın mı? Veriler kendiliğinden gelir; boş başla."
          }
        }
      }
    },
    "“%@” was not found; the link is left out" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
