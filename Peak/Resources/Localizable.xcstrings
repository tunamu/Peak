    "A backup is saved first in Files › Peak › Backups. Import it to bring everything back." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce Dosyalar › Peak › Backups içine yedek kaydedilir. Her şeyi geri getirmek için onu içe aktar."
          }
        }
      }
    },
    "A backup was saved first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce yedek kaydedildi."
          }
        }
      }
    },
    "A missed day never skips a workout: the next one moves to the next routine day." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaçırılan gün antrenman atlatmaz: sıradaki antrenman bir sonraki rutin gününe kayar."
          }
        }
      }
    },
    "A movement has no exercise name" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hareketin adı yok"
